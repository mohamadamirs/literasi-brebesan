# ==========================================
# LITERASI BREBESAN - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE (PostgreSQL)
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=require
POSTGRES_URL="postgres://default:xxxx@ep-xxxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# (Untuk persiapan TiDB / Prisma mendatang):
# DATABASE_URL="mysql://[user]:[password]@[gateway]:4000/[database]?sslaccept=strict"

# 2. AUTENTIKASI & KEAMANAN JWT
# Buat string acak minimal 32 karakter (misal via `openssl rand -base64 32`)
AUTH_SECRET="ganti-dengan-kunci-rahasia-acak-minimal-32-karakter-keamanan"

# 3. CLOUD STORAGE (ImageKit.io)
# Diperoleh dari Dashboard ImageKit -> Developer Options
IMAGEKIT_PUBLIC_KEY="public_..."
IMAGEKIT_PRIVATE_KEY="private_..."
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/..."

# 4. EMAIL SERVICE (Resend)
# Diperoleh dari https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Opsional: default "Literasi Brebesan <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Literasi Brebesan <onboarding@resend.dev>"

# 5. GOOGLE DRIVE API (Arsip Dokumentasi)
# Diperoleh dari Service Account Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL="literasi-service@project-id.iam.gserviceaccount.com"
# Catatan: Masukkan private key utuh dengan kutip, termasuk \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# ID folder Google Drive utama
GOOGLE_DRIVE_ROOT_FOLDER_ID="1a2b3c4d5e6f7g8h9i0jklmnopqrstuv"

# 6. CRON JOB SECURITY
# Token proteksi untuk endpoint /api/cron/*
CRON_SECRET="kunci-rahasia-cron-job"

# 7. WHATSAPP GATEWAY ENGINE (OPSIONAL / TIDAK DIGUNAKAN SAAT INI)
# Jika fitur WhatsApp belum diaktifkan, biarkan kosong.
# URL service WhatsApp Gateway (LAN laptop atau Cloudflare Tunnel)
# WA_GATEWAY_URL=""
# Token otentikasi Bearer API Key yang sama dengan yang dipasang di whatsapp-gateway
# WA_GATEWAY_SECRET=""
# Nomor WhatsApp Admin / Komunitas tujuan notifikasi (format: 628xxx)
# WA_ADMIN_PHONE=""

# Catatan:
# Saat ini fitur WhatsApp dinonaktifkan, sehingga variabel di atas tidak wajib diisi.
# Jika nanti diaktifkan, isi value yang sesuai dan pastikan gateway sudah siap di production.

