---
import Layout from "@/shared/layouts/Layout.astro";
import Header from "@/shared/layouts/Header.astro";
import Footer from "@/shared/layouts/Footer.astro";
import ActionFeedback from "@/shared/ui/ActionFeedback";
const { title, description } = Astro.props;
---

<Layout
  title={title}
  description={description}
  bodyClass="bg-slate-50/50 min-h-screen font-sans antialiased text-slate-900"
>
  <ActionFeedback client:load />
  <Header />

  <main class="pt-32 pb-12 md:pt-44 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </div>
  </main>

  <Footer />
</Layout>