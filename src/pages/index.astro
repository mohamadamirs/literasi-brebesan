---
import Layout from "@/shared/layouts/Layout.astro";
import Header from "@/shared/layouts/Header.astro";
import Hero from "@/features/home/Hero.astro";
import About from "@/features/home/About.astro";
import Stats from "@/features/home/Stats.astro";
import Agenda from "@/features/agenda/Agenda.astro";
import LatestPosts from "@/features/posts/LatestPosts.astro";
import GaleriGrid from "@/features/docs/GaleriGrid.astro";
import Footer from "@/shared/layouts/Footer.astro";

// JSON-LD untuk Beranda
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Literasi Brebesan",
  "alternateName": ["LIBES", "Komunitas Literasi Brebes", "Literasi Brebes"],
  "url": "https://literasibrebesan.my.id",
  "logo": "https://literasibrebesan.my.id/literasi-brebesan.webp",
  "description": "Komunitas Literasi Brebesan adalah wadah independen di Kabupaten Brebes yang berfokus pada pengembangan budaya membaca, diskusi kritis, dan aksi sosial nyata.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Brebes",
    "addressRegion": "Jawa Tengah",
    "addressCountry": "ID"
  },
  "sameAs": [
    "https://www.instagram.com/literasibrebesan"
  ]
};

// Set Cache-Control header for the home page (1 hour SWR)
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=1800');
Astro.response.headers.set('Vary', 'Cookie');
---

<Layout 
  title="Literasi Brebesan | Komunitas Literasi & Ruang Baca Gratis di Brebes" 
  description="Wadah Komunitas Literasi di Brebes. Nikmati ruang diskusi, lapak baca buku gratis, dan aksi nyata untuk merawat nalar. Selamat datang di Literasi Brebesan!"
  schema={homeSchema}
>
  <Header />
  <main>
    <Hero />
    <Stats />
    <Agenda />
    <About />
    <LatestPosts />
    <GaleriGrid />
  </main>
  <Footer />
</Layout>
