---
import { postsService } from "@/features/posts/posts.service";
import { Image } from "astro:assets";
import { formatDate, truncateTitle, truncateText, extractFirstImage } from "@/shared/utils/utils";

const posts = await postsService.getPublishedPosts({ limit: 3 });
const featured = posts[0];
const rest = posts.slice(1);
const featuredImage = featured ? extractFirstImage(featured.content || "") : null;
const featuredSpan = posts.length >= 3 ? "md:col-span-2" : "";
---

<section id="posts" class="relative overflow-hidden border-t border-slate-100 bg-white py-20 md:py-28 scroll-mt-20 md:scroll-mt-28">
  <div class="section-shell">
    <div class="reveal mb-10 flex flex-col gap-6 md:mb-14 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="eyebrow border-blue-100 bg-blue-50 text-blue-700">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-600" aria-hidden="true"></span>
          Tulisan Terbaru
        </div>

        <h2 class="display-title mt-5 text-slate-950">
          Ruang <span class="text-blue-600">karya</span>
        </h2>

        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-500 md:text-lg">
          Gagasan dan cerita dari teman-teman melalui tulisan.
        </p>
      </div>

      <a href="/publikasi" class="group inline-flex items-center gap-2 self-start text-[11px] font-black uppercase tracking-widest text-slate-500 transition-colors hover:text-blue-600 md:self-auto">
        Lihat semua tulisan
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>

    {featured ? (
      <div class="reveal grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
        <article class={`group relative overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lift ${featuredSpan}`}>
          <div class={`grid h-full ${featuredImage ? "md:grid-cols-2" : ""}`}>
            {featuredImage && (
              <div class="relative min-h-[240px] overflow-hidden bg-slate-100 sm:min-h-[320px] md:min-h-full">
                <Image
                  src={featuredImage}
                  alt={featured.title}
                  width={900}
                  height={700}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/25 to-transparent" aria-hidden="true"></div>
              </div>
            )}

            <div class="flex flex-col p-6 md:p-8">
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full border border-blue-100 bg-blue-50 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-blue-600">
                  {featured.category_name || "Umum"}
                </span>
                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                  {formatDate(featured.updated_at)}
                </span>
              </div>

              <h3 class="mt-5 text-2xl font-black leading-tight text-slate-900 transition-colors group-hover:text-blue-600 md:text-3xl" title={featured.title}>
                <a href={`/publikasi/${featured.slug}`} class="before:absolute before:inset-0 outline-none">
                  {truncateTitle(featured.title, 70)}
                </a>
              </h3>

              <p class="mt-4 flex-grow text-sm leading-relaxed text-slate-500">
                {truncateText(featured.content || "", 180)}
              </p>

              <div class="relative z-20 mt-6 flex items-center justify-between gap-3 border-t border-slate-100 pt-5">
                <div class="flex min-w-0 items-center gap-2.5">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full bg-blue-100 text-[10px] font-black uppercase text-blue-600">
                    {featured.author_avatar ? (
                      <img src={featured.author_avatar} alt={featured.author_name || "Penulis"} class="h-full w-full object-cover" loading="lazy" />
                    ) : (
                      featured.author_name?.charAt(0) || "U"
                    )}
                  </span>
                  <span class="truncate text-[11px] font-black uppercase tracking-wider text-slate-700">{featured.author_name || "Anonim"}</span>
                </div>

                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-100 bg-slate-50 text-slate-500 transition-all group-hover:border-blue-600 group-hover:bg-blue-600 group-hover:text-white">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
                </span>
              </div>
            </div>
          </div>
        </article>

        {rest.map((post) => (
          <article class="group relative flex flex-col overflow-hidden rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lift md:p-8">
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full border border-slate-100 bg-slate-50 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-slate-500">
                {post.category_name || "Umum"}
              </span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                {formatDate(post.updated_at)}
              </span>
            </div>

            <h3 class="mt-5 text-lg font-black leading-tight text-slate-900 transition-colors group-hover:text-blue-600 md:text-xl" title={post.title}>
              <a href={`/publikasi/${post.slug}`} class="before:absolute before:inset-0 outline-none">
                {truncateTitle(post.title, 60)}
              </a>
            </h3>

            <p class="mt-3 flex-grow text-sm leading-relaxed text-slate-500">
              {truncateText(post.content || "", 120)}
            </p>

            <div class="relative z-20 mt-6 flex items-center justify-between gap-3 border-t border-slate-100 pt-5">
              <div class="flex min-w-0 items-center gap-2.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-slate-100 text-[10px] font-black uppercase text-slate-600">
                  {post.author_avatar ? (
                    <img src={post.author_avatar} alt={post.author_name || "Penulis"} class="h-full w-full object-cover" loading="lazy" />
                  ) : (
                    post.author_name?.charAt(0) || "U"
                  )}
                </span>
                <span class="truncate text-[10px] font-black uppercase tracking-wider text-slate-700">{post.author_name || "Anonim"}</span>
              </div>

              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-slate-50 text-slate-400 transition-all group-hover:bg-blue-600 group-hover:text-white">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
              </span>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="reveal rounded-[2rem] border border-dashed border-slate-200 bg-slate-50 p-10 text-center md:p-16">
        <p class="text-lg font-black text-slate-900">Belum ada tulisan</p>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-500">
          Karya teman-teman akan tampil di sini setelah dipublikasikan.
        </p>
        <a href="/publikasi" class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-slate-900 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-white transition-colors hover:bg-blue-600">
          Kunjungi publikasi
        </a>
      </div>
    )}
  </div>
</section>
