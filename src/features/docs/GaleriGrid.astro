---
import FeaturedGallery from "@/features/docs/FeaturedGallery";
---

<section id="galeri" class="relative overflow-hidden bg-slate-950 py-20 text-white md:py-28 scroll-mt-20 md:scroll-mt-28">
  <div class="absolute -right-20 top-0 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-1/4 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="section-shell relative">
    <div class="reveal mb-10 flex flex-col gap-6 text-left md:mb-14 md:flex-row md:items-end md:justify-between">
      <div>
        <div class="eyebrow border-white/10 bg-white/5 text-white/70">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-400" aria-hidden="true"></span>
          Dokumentasi
        </div>

        <h2 class="display-title mt-5 text-white">
          Merawat <span class="text-blue-400">momen</span>
        </h2>

        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-400 md:text-lg">
          Arsip visual perjalanan dan perjumpaan kita dalam merawat nalar.
        </p>
      </div>

      <a href="/dokumentasi" class="group inline-flex items-center gap-2 self-start rounded-2xl border border-white/15 bg-white px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-slate-950 transition-all hover:-translate-y-0.5 hover:bg-blue-500 hover:text-white md:self-auto">
        Galeri penuh
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
    </div>

    <div class="reveal">
      <FeaturedGallery client:visible />
    </div>
  </div>
</section>
