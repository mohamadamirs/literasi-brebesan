---
import { getLatestMedia } from "@/features/docs/googleDrive";

const latestMedia = await getLatestMedia(1);
const latestImage = latestMedia.length > 0 ? latestMedia[0] : null;
---

<section id="hero" class="relative overflow-hidden bg-paper pt-28 pb-16 md:pt-40 md:pb-24 text-left">
  <div class="mesh-bg" aria-hidden="true"></div>
  <div class="absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>

  <div class="section-shell relative">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-6 md:space-y-8 lg:col-span-7">
        <div class="eyebrow border-blue-100 bg-white/70 text-blue-700 shadow-sm">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-600"></span>
          </span>
          Selamat Datang di Literasi Brebesan
        </div>

        <h1 class="display-title text-slate-950">
          Tempat dimana setiap <span class="text-blue-600">cerita layak</span> untuk didengar.
        </h1>

        <p class="max-w-xl text-base leading-relaxed text-slate-600 md:text-lg">
          Dan setiap ide dihargai sebagaimana semestinya. Ruang temu alternatif di Kabupaten Brebes untuk merawat nalar melalui diskusi, membaca, dan aksi nyata.
        </p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[11px] font-bold uppercase tracking-widest text-slate-500">
          <span class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-600" aria-hidden="true"></span>
            Brebes, Jawa Tengah
          </span>
          <span class="hidden h-3 w-px bg-slate-300 sm:block" aria-hidden="true"></span>
          <span>Sejak 29 Juni 2025</span>
        </div>

        <div class="flex flex-col items-stretch gap-3 pt-2 sm:flex-row sm:items-center">
          <a
            href="https://wa.me/628993986415"
            target="_blank"
            class="group inline-flex items-center justify-center gap-3 rounded-2xl bg-blue-600 px-7 py-4 text-xs font-black uppercase tracking-widest text-white shadow-glow transition-all hover:-translate-y-0.5 hover:bg-slate-900 active:translate-y-0"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
            Gabung Komunitas
          </a>
          <a
            href="#agenda"
            class="group inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white/70 px-7 py-4 text-xs font-black uppercase tracking-widest text-slate-700 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-blue-200 hover:text-blue-600"
          >
            Lihat Agenda
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>

        <a href="#tentang" class="inline-flex items-center gap-3 rounded-full border border-slate-200 bg-white/70 px-3 py-2 shadow-sm backdrop-blur transition-colors hover:border-blue-200">
          <span class="flex -space-x-1.5" aria-hidden="true">
            {[1, 2, 3].map((i) => (
              <span class={`flex h-6 w-6 items-center justify-center rounded-full border border-white text-[9px] font-black text-white ${i === 1 ? "bg-blue-500" : i === 2 ? "bg-indigo-500" : "bg-slate-800"}`}>
                {i === 1 ? "A" : i === 2 ? "B" : "C"}
              </span>
            ))}
          </span>
          <span class="text-[10px] font-bold text-slate-500"><span class="font-black text-slate-900">130+</span> kawan bergabung</span>
          <svg class="h-3 w-3 text-slate-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
        </a>
      </div>

      <div class="relative mx-auto w-full max-w-[520px] lg:col-span-5">
        <div class="absolute -inset-6 rounded-[3rem] bg-gradient-to-tr from-blue-600/20 via-indigo-500/10 to-amber-400/20 blur-2xl" aria-hidden="true"></div>

        <div class="relative rotate-2 overflow-hidden rounded-[2.5rem] border border-white bg-white p-2.5 shadow-lift transition-transform duration-700 hover:rotate-0">
          <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-slate-100 sm:aspect-[4/3] lg:aspect-[4/5]">
            <img
              src={latestImage ? `/api/drive-image/${latestImage.id}?sz=800` : "/literasi-brebesan.webp"}
              alt={latestImage ? latestImage.name : "Literasi Brebesan"}
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/10 to-transparent" aria-hidden="true"></div>

            <span class="eyebrow absolute left-4 top-4 border-white/30 bg-white/15 text-[10px] text-white backdrop-blur md:left-5 md:top-5">
              Arsip Komunitas
            </span>

            <div class="absolute inset-x-4 bottom-4 md:inset-x-5 md:bottom-5">
              <p class="text-[10px] font-black uppercase tracking-widest text-blue-200">Literasi Brebesan</p>
              <p class="mt-1 text-lg font-bold leading-tight text-white md:text-xl">Merawat nalar, menjalin kedekatan.</p>
            </div>
          </div>
        </div>

        <div class="animate-float-soft absolute -left-3 bottom-20 rounded-2xl border border-slate-100 bg-white/95 p-3.5 shadow-xl backdrop-blur md:-left-8 md:bottom-24">
          <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Ruang baca</p>
          <p class="mt-0.5 text-sm font-black text-slate-900">Gratis untuk semua</p>
        </div>

        <div class="absolute -right-2 top-8 rounded-2xl border border-slate-100 bg-white/95 p-3.5 shadow-xl backdrop-blur md:-right-6 md:top-10">
          <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Bergerak sejak</p>
          <p class="mt-0.5 text-sm font-black text-slate-900">2025</p>
        </div>
      </div>
    </div>
  </div>
</section>
